{
  "name": "@nova/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "bundle": "node scripts/bundle.mjs",
    "start:prod": "node --enable-source-maps dist/main.js",
    "admin:prod": "node dist/cli.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json",
    "db:migrate": "tsx src/db/cli.ts migrate",
    "db:seed": "tsx src/db/cli.ts seed",
    "db:reset-e2e": "tsx src/db/cli.ts reset-e2e",
    "db:rotate-keys": "tsx src/db/cli.ts rotate-keys",
    "admin": "tsx src/db/cli.ts",
    "start:e2e": "tsx src/db/cli.ts reset-e2e && tsx src/main.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/static": "^10.1.4",
    "@fastify/websocket": "^11.3.1",
    "@nova/contracts": "workspace:*",
    "@nova/permissions": "workspace:*",
    "@simplewebauthn/server": "^14.0.3",
    "diff": "^9.0.0",
    "fastify": "^5.12.5",
    "pdfjs-dist": "^6.3.289",
    "pg": "^8.23.0",
    "ws": "^8.21.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "vitest": "^5.0.2"
  }
}
