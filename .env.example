# Skopiuj do .env i dostosuj. Plik .env jest ignorowany przez Git.
# Nigdy nie umieszczaj w repozytorium prawdziwych kluczy ani tokenów.

# Środowisko: development | test | production
NOVA_ENV=development

# API
NOVA_API_HOST=127.0.0.1
NOVA_API_PORT=4000
# Publiczny adres web (dla CORS/Origin i ciasteczek). W dev Vite proxy kieruje /api -> API.
NOVA_WEB_ORIGIN=http://localhost:5173

# Postgres: rola aplikacji (RLS) i rola właściciela (migracje, kolejka, audyt).
# Wartości poniżej odpowiadają lokalnemu klastrowi dev (infra/db/init.sql).
DATABASE_URL_APP=postgres://nova_app:nova_app_dev@127.0.0.1:54329/nova_dev
DATABASE_URL_OWNER=postgres://nova_owner:nova_owner_dev@127.0.0.1:54329/nova_dev
# Tylko wariant Docker (infra/compose.yaml): hasło superużytkownika kontenera Postgres. Wygeneruj własne,
# np. `openssl rand -base64 24` — nie commituj. (Role nova_app/nova_owner powyżej to hasła lokalnego klastra dev.)
NOVA_PG_SUPERUSER_PASSWORD=

# Logowanie testowe (dwa sztuczne konta). Działa TYLKO gdy NOVA_ENV=development lub test.
# Ustawienie true przy NOVA_ENV=production zatrzymuje start serwera.
NOVA_DEV_LOGIN=true

# Klucz szyfrowania sekretów w spoczynku (tokeny OAuth, klucze API dodane w aplikacji). 32 bajty base64.
# Wygeneruj: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NOVA_SECRET_KEY=
NOVA_SECRET_KEY_ID=k1

# Model: ścieżka do konfiguracji routingu modeli (patrz infra/config/models.example.json).
# Brak pliku lub dostawca "fake" => tryb demo (bez płatnych wywołań), jawnie oznaczony w UI.
NOVA_MODELS_CONFIG=infra/config/models.example.json
# Klucze dostawców są czytane wyłącznie po stronie serwera. Puste => dostawca "not configured".
# Prościej: właściciel domu dodaje klucze w aplikacji (Modele AI i klucze API) — wymaga NOVA_SECRET_KEY.
ANTHROPIC_API_KEY=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_BASE_URL=

# Dostawca dodany w aplikacji może wskazywać lokalny serwer (http://localhost, np. Ollama).
# Puste => dozwolone poza produkcją. W produkcji włącz świadomie (true), gdy model działa na tym samym serwerze.
NOVA_MODELS_ALLOW_LOCAL=

# Głos ElevenLabs (odczyt odpowiedzi i przeglądu dnia na głos). Pusty klucz => głos przeglądarki.
# Klucz: elevenlabs.io → Profile → API Keys. Zostaje tylko na serwerze; płatność wg planu ElevenLabs (znaki).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=o2xdfKUpc1Bwq7RchZuW
# eleven_flash_v2_5: najniższe opóźnienie, połowa kosztu znaku; eleven_multilingual_v2: wyższa jakość.
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
# Miesięczny limit znaków na dom po stronie NovaAI (0 = bez limitu).
ELEVENLABS_MONTHLY_CHARS=30000
# Rozpoznawanie mowy przez ElevenLabs (ten sam klucz) — tylko gdy przeglądarka sama nie rozpoznaje mowy
# (np. Brave, Opera, Vivaldi, Firefox). Płatne za długość nagrania; limit minut na dom w miesiącu (0 = wyłączone).
ELEVENLABS_STT_MODEL_ID=scribe_v2
ELEVENLABS_STT_MONTHLY_MINUTES=60

# Kolejka zadań
NOVA_QUEUE_ENABLED=true
NOVA_QUEUE_LEASE_MS=30000

# Stare klucze (tylko do odszyfrowania po rotacji): "k0:base64,k-1:base64". Rotacja: pnpm --filter @nova/api db:rotate-keys
NOVA_SECRET_KEYS_OLD=
# Publiczny adres aplikacji (redirect OAuth). Domyślnie NOVA_WEB_ORIGIN.
NOVA_PUBLIC_URL=
# Adres kontaktowy administratora na stronach /privacy i /terms (Google wymaga ich przy publikacji OAuth).
NOVA_CONTACT_EMAIL=

# Google (OAuth „Web application” w Google Cloud Console). Puste => integracja „not configured”.
# Redirect URI do zarejestrowania: <NOVA_PUBLIC_URL>/api/connections/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Usługi i koszty — klucze ADMINISTRACYJNE do odczytu raportów kosztów organizacji (tylko serwer, nigdy w UI/bazie).
# Puste => adapter „niepodłączony”. Anthropic: Admin API key (sk-ant-admin…; niedostępny dla kont indywidualnych).
# OpenAI: Admin API key organizacji. Oba tylko do odczytu kosztów (docs/DECISIONS.md D-029).
ANTHROPIC_ADMIN_API_KEY=
OPENAI_ADMIN_API_KEY=

# Microsoft (Outlook: poczta i kalendarz) — rejestracja aplikacji w Microsoft Entra (typ „Web”, sekret klienta).
# Puste => integracja „not configured”. Redirect URI do zarejestrowania:
#   <NOVA_PUBLIC_URL>/api/connections/microsoft/callback
# Uprawnienia delegowane (Microsoft Graph): Mail.ReadBasic, Mail.Read, Mail.Send, Calendars.ReadBasic,
# opcjonalnie Mail.ReadWrite (szkiche) oraz offline_access, openid, profile. Szczegóły: docs/DECISIONS.md D-027.
# MICROSOFT_TENANT: common (konta osobiste i służbowe), organizations, consumers albo ID dzierżawy.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common

# Slack — aplikacja z tokenami UŻYTKOWNIKA (api.slack.com/apps → OAuth & Permissions, User Token Scopes):
# search:read.public (+ opcjonalnie search:read.private, search:read.im, search:read.mpim), chat:write, channels:read,
# groups:read. Redirect URL (HTTPS): <NOVA_PUBLIC_URL>/api/connections/slack/callback. Puste => „not configured”.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Events API (Request URL: <NOVA_PUBLIC_URL>/api/webhooks/slack; zdarzenia tokens_revoked, app_uninstalled) —
# sekret podpisu do weryfikacji. Puste => webhook Slack wyłączony.
SLACK_SIGNING_SECRET=

# Passkeys (WebAuthn): domena RP (bez portu; IP nie jest dozwolone), nazwa i originy (po przecinku).
# Domyślnie z NOVA_WEB_ORIGIN. W dev używaj http://localhost:5173 (nie 127.0.0.1).
NOVA_RP_ID=localhost
NOVA_RP_NAME=NovaAI
NOVA_RP_ORIGINS=http://localhost:5173

# Za reverse proxy (TLS): liczba zaufanych przeskoków, np. 1. Domyślnie 0 — X-Forwarded-For jest ignorowany.
NOVA_TRUST_PROXY=0

# Produkcja: katalog zbudowanego frontendu (pnpm build:prod) serwowany przez API z tego samego originu.
# Puste w dev (frontend z Vite).
NOVA_WEB_DIST=
