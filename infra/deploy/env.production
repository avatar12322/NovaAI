# Szablon .env serwera produkcyjnego (novaai.pl). setup-server.sh kopiuje go do /opt/novaai/app/.env
# i wstawia w miejsce @…@ losowe hasła ról Postgres oraz klucz szyfrowania — generowane na serwerze,
# nigdzie nie wypisywane. Klucze usług (puste poniżej) wpisuje właściciel na serwerze:
#   sudo nano /opt/novaai/app/.env
# Ten plik w repozytorium NIE zawiera żadnych sekretów i nie powinien ich nigdy zawierać.

NOVA_ENV=production
NOVA_DEV_LOGIN=false
NOVA_API_HOST=127.0.0.1
NOVA_API_PORT=4000
NOVA_WEB_ORIGIN=https://novaai.pl
NOVA_PUBLIC_URL=https://novaai.pl
NOVA_RP_ID=novaai.pl
NOVA_RP_NAME=NovaAI
NOVA_RP_ORIGINS=https://novaai.pl
# Caddy na tym samym serwerze = jeden zaufany przeskok.
NOVA_TRUST_PROXY=1
NOVA_WEB_DIST=apps/web/dist

DATABASE_URL_APP=postgres://nova_app:@APP_DB_PASSWORD@@127.0.0.1:5432/novaai
DATABASE_URL_OWNER=postgres://nova_owner:@OWNER_DB_PASSWORD@@127.0.0.1:5432/novaai

# Klucz szyfrowania tokenów OAuth i kluczy API dodanych w aplikacji. ZRÓB KOPIĘ tej linii w menedżerze
# haseł — bez niej po odtworzeniu bazy z kopii połączone konta i klucze trzeba dodać od nowa.
NOVA_SECRET_KEY=@SECRET_KEY@
NOVA_SECRET_KEY_ID=k1
NOVA_SECRET_KEYS_OLD=

NOVA_QUEUE_ENABLED=true
NOVA_QUEUE_LEASE_MS=30000

# Modele: dodawane w aplikacji (Modele AI i klucze API) — klucz Anthropic może zostać tutaj.
NOVA_MODELS_CONFIG=
NOVA_MODELS_ALLOW_LOCAL=false
ANTHROPIC_API_KEY=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_BASE_URL=

# ElevenLabs (plan Creator, docs/DEPLOY.md → Budżet).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=o2xdfKUpc1Bwq7RchZuW
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_MONTHLY_CHARS=100000
ELEVENLABS_STT_MODEL_ID=scribe_v2
ELEVENLABS_STT_MONTHLY_MINUTES=60

# Google (te same co lokalnie; redirect https://novaai.pl/api/connections/google/callback).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Pominięte integracje — puste = „niepodłączone”.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
ANTHROPIC_ADMIN_API_KEY=
OPENAI_ADMIN_API_KEY=
